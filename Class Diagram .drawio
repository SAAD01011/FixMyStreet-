      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nskinparam roundcorner 6\n\nskinparam class {\n    BackgroundColor #FDFEFE\n    BorderColor #2C3E50\n    ArrowColor #2C3E50\n    HeaderBackgroundColor #EAEDED\n}\n\n&#39; ================= Enumerations =================\nenum UserRole {\n    CITIZEN\n    DEPARTMENT_OFFICER\n    FIELD_WORKER\n    SYSTEM_ADMIN\n}\n\nenum UrgencyLevel {\n    LOW\n    MEDIUM\n    HIGH\n    EMERGENCY\n}\n\nenum PriorityLevel {\n    P1_EMERGENCY\n    P2_HIGH\n    P3_MEDIUM\n    P4_LOW\n}\n\nenum ComplaintStatus {\n    SUBMITTED\n    UNDER_REVIEW\n    ASSIGNED\n    IN_PROGRESS\n    RESOLVED\n    CLOSED\n    REJECTED\n}\n\n&#39; ================= Base &amp; Inherited Classes =================\nabstract class User {\n    - userId: String\n    - fullName: String\n    - email: String\n    - phoneNumber: String\n    - passwordHash: String\n    - role: UserRole\n    - isActive: Boolean\n    - createdAt: DateTime\n    + authenticate(password: String): Boolean\n    + updateProfile(name: String, phone: String): Void\n    + resetPassword(token: String): Boolean\n}\n\nclass Citizen {\n    - residentialAddress: String\n    - totalReportedComplaints: Integer\n    + submitComplaint(data: ComplaintDTO): Complaint\n    + viewMyComplaints(): List&lt;Complaint&gt;\n    + verifyAndRateResolution(id: String, score: Integer, text: String): Void\n    + reopenComplaint(id: String, reason: String): Void\n}\n\nclass DepartmentOfficer {\n    - employeeId: String\n    - departmentId: String\n    - designation: String\n    + getDepartmentQueue(): List&lt;Complaint&gt;\n    + assignWorker(complaintId: String, workerId: String, targetDate: DateTime): Boolean\n    + mergeDuplicateTickets(masterId: String, childId: String): Void\n    + rerouteTicket(complaintId: String, targetDeptId: String, reason: String): Void\n    + rejectTicket(complaintId: String, reason: String): Void\n}\n\nclass FieldWorker {\n    - workerCode: String\n    - tradeSkill: String\n    - isDutyActive: Boolean\n    - currentLatitude: Double\n    - currentLongitude: Double\n    + getAssignedWorkOrders(): List&lt;Complaint&gt;\n    + markWorkInProgress(complaintId: String): Void\n    + submitProofAndResolve(complaintId: String, photoUri: String, notes: String): Void\n}\n\nclass SystemAdministrator {\n    - superUserKey: String\n    + createDepartment(data: DeptDTO): Department\n    + registerDepartmentOfficer(data: UserDTO): DepartmentOfficer\n    + getSlaAnalytics(): AnalyticsReport\n    + generateMonthlyComplianceAudit(): ReportDocument\n}\n\n&#39; ================= Core Entities =================\nclass Department {\n    - departmentId: String\n    - departmentName: String\n    - shortCode: String\n    - contactEmail: String\n    - operationalJurisdiction: String\n    + getActiveStaffCount(): Integer\n}\n\nclass ComplaintCategory {\n    - categoryId: String\n    - name: String\n    - description: String\n    - defaultDepartmentId: String\n    - standardSlaHours: Integer\n}\n\nclass Complaint {\n    - complaintId: String\n    - citizenId: String\n    - departmentId: String\n    - categoryId: String\n    - description: String\n    - initialPhotoUrl: String\n    - proofPhotoUrl: String\n    - latitude: Double\n    - longitude: Double\n    - physicalAddress: String\n    - urgency: UrgencyLevel\n    - priority: PriorityLevel\n    - status: ComplaintStatus\n    - assignedWorkerId: String\n    - slaDeadline: DateTime\n    - submittedAt: DateTime\n    - resolvedAt: DateTime\n    - isEscalated: Boolean\n    + calculatePriorityAndSLA(): Void\n    + transitionStatus(newStatus: ComplaintStatus): Void\n    + isSlaViolated(): Boolean\n    + linkDuplicate(masterComplaintId: String): Void\n}\n\nclass Feedback {\n    - feedbackId: String\n    - complaintId: String\n    - citizenId: String\n    - ratingScore: Integer\n    - reviewComments: String\n    - submittedAt: DateTime\n    - isDisputed: Boolean\n    + validateScore(): Boolean\n}\n\nclass Notification {\n    - notificationId: String\n    - recipientUserId: String\n    - channel: String\n    - messageContent: String\n    - isRead: Boolean\n    - sentTimestamp: DateTime\n    + deliver(): Boolean\n}\n\n&#39; ================= Relationships =================\nUser &lt;|-- Citizen\nUser &lt;|-- DepartmentOfficer\nUser &lt;|-- FieldWorker\nUser &lt;|-- SystemAdministrator\n\nDepartment \&quot;1\&quot; o-- \&quot;0..*\&quot; DepartmentOfficer : employs &gt;\nDepartment \&quot;1\&quot; o-- \&quot;0..*\&quot; FieldWorker : dispatches &gt;\nDepartment \&quot;1\&quot; -- \&quot;0..*\&quot; ComplaintCategory : governs &gt;\n\nCitizen \&quot;1\&quot; -- \&quot;0..*\&quot; Complaint : files &gt;\nDepartment \&quot;1\&quot; -- \&quot;0..*\&quot; Complaint : manages &gt;\nComplaintCategory \&quot;1\&quot; -- \&quot;0..*\&quot; Complaint : classifies &gt;\n\nDepartmentOfficer \&quot;1\&quot; -- \&quot;0..*\&quot; Complaint : allocates &gt;\nFieldWorker \&quot;0..1\&quot; -- \&quot;0..*\&quot; Complaint : physically executes &gt;\n\nComplaint \&quot;1\&quot; *-- \&quot;0..1\&quot; Feedback : assessed by &gt;\nComplaint \&quot;1\&quot; *-- \&quot;0..*\&quot; Notification : generates &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="bESfwiYBwNWAUbp8ylx1-139">
