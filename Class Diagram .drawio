        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nabstract class User {\n    - userId : String\n    - fullName : String\n    - email : String\n    - phone : String\n    - role : String\n    + login() : Boolean\n}\n\nclass Citizen {\n    - address : String\n    + submitComplaint()\n    + trackStatus()\n    + rateResolution()\n    + reopenComplaint()\n}\n\nclass DepartmentOfficer {\n    - officerId : String\n    - departmentId : String\n    + reviewQueue()\n    + assignWorker()\n    + mergeDuplicates()\n    + rejectComplaint()\n}\n\nclass FieldWorker {\n    - workerId : String\n    - specialty : String\n    + getAssignedTasks()\n    + updateProgress()\n    + uploadProof()\n}\n\nclass Administrator {\n    + manageUsers()\n    + manageDepartments()\n    + viewAnalytics()\n}\n\nclass Complaint {\n    - complaintId : String\n    - category : String\n    - description : String\n    - photoUri : String\n    - proofPhotoUri : String\n    - latitude : Double\n    - longitude : Double\n    - urgency : String\n    - priority : String\n    - status : String\n    - slaDeadline : DateTime\n    + calculatePriority()\n    + updateStatus()\n}\n\nclass Feedback {\n    - feedbackId : String\n    - ratingScore : Integer\n    - comment : String\n}\n\nclass Department {\n    - departmentId : String\n    - name : String\n    - contactEmail : String\n}\n\nUser &lt;|-- Citizen\nUser &lt;|-- DepartmentOfficer\nUser &lt;|-- FieldWorker\nUser &lt;|-- Administrator\n\nCitizen \&quot;1\&quot; -- \&quot;0..*\&quot; Complaint : submits &gt;\nDepartment \&quot;1\&quot; -- \&quot;0..*\&quot; DepartmentOfficer : employs &gt;\nDepartment \&quot;1\&quot; -- \&quot;0..*\&quot; FieldWorker : directs &gt;\nDepartment \&quot;1\&quot; -- \&quot;0..*\&quot; Complaint : handles &gt;\n\nDepartmentOfficer \&quot;1\&quot; -- \&quot;0..*\&quot; Complaint : assigns &gt;\nFieldWorker \&quot;0..1\&quot; -- \&quot;0..*\&quot; Complaint : resolves &gt;\nComplaint \&quot;1\&quot; *-- 