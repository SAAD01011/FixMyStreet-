        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam roundcorner 6\n\nskinparam node {\n    BackgroundColor #F8F9F9\n    BorderColor #34495E\n}\n\nskinparam component {\n    BackgroundColor #EBF5FB\n    BorderColor #2980B9\n}\n\nnode \&quot;Client Endpoints\&quot; {\n    node \&quot;Citizen Mobile Device / Laptop\&quot; {\n        artifact \&quot;Web Browser (Chrome/Safari)\\n[Citizen SPA Client]\&quot; as CitizenClient\n    }\n    \n    node \&quot;Municipal Office PC\&quot; {\n        artifact \&quot;Desktop Browser\\n[Officer &amp; Admin Console]\&quot; as OfficeClient\n    }\n    \n    node \&quot;Field Technician Smartphone\&quot; {\n        artifact \&quot;Mobile Browser / PWA\\n[Field Work Execution App]\&quot; as WorkerClient\n    }\n}\n\nnode \&quot;Cloud Infrastructure (AWS VPC / DigitalOcean)\&quot; as Cloud {\n    node \&quot;DMZ / Edge Network Tier\&quot; {\n        component \&quot;Reverse Proxy &amp; TLS Termination\\n(Nginx Load Balancer)\&quot; as Nginx\n    }\n\n    node \&quot;Application Tier (Compute Cluster)\&quot; {\n        node \&quot;Node.js / Express Container Instance\&quot; {\n            component \&quot;FixMyStreet REST API Service\&quot; as BackendAPI\n            component \&quot;Priority &amp; SLA Rule Engine\&quot; as RuleEngine\n            component \&quot;Notification Dispatch Worker\&quot; as BackgroundWorker\n        }\n    }\n\n    node \&quot;Data Storage Tier\&quot; {\n        node \&quot;Managed Database Server\&quot; {\n            database \&quot;PostgreSQL with PostGIS\\n(Port 5432)\&quot; as PrimaryDB\n        }\n        node \&quot;In-Memory Cache\&quot; {\n            database \&quot;Redis Cache / Message Broker\\n(Port 6379)\&quot; as RedisCache\n        }\n    }\n}\n\ncloud \&quot;Third-Party External Services\&quot; as External {\n    node \&quot;Google Cloud Platform\&quot; {\n        component \&quot;Google Maps API Service\\n(Reverse Geocode &amp; Directions)\&quot; as MapsAPI\n    }\n    \n    node \&quot;AWS Cloud Storage\&quot; {\n        component \&quot;Amazon S3 Encrypted Bucket\\n(Evidence Photos)\&quot; as S3Bucket\n    }\n    \n    node \&quot;Telecommunications Provider\&quot; {\n        component \&quot;Twilio SMS &amp; SendGrid Gateway\&quot; as SMSGateway\n    }\n}\n\n&#39; Network connections\nCitizenClient -- Nginx : HTTPS (Port 443)\nOfficeClient -- Nginx : HTTPS (Port 443)\nWorkerClient -- Nginx : HTTPS (Port 443)\n\nNginx -- BackendAPI : Internal HTTP (Port 3000)\nBackendAPI -- RuleEngine : Internal Process\nBackendAPI -- BackgroundWorker : Task Queue\n\nBackendAPI -- PrimaryDB : Secure TCP/IP\nBackendAPI -- RedisCache : Port 6379\n\nBackendAPI -- MapsAPI : HTTPS REST API\nBackendAPI -- S3Bucket : AWS SDK / TLS\nBackgroundWorker -- SMSGateway : HTTPS REST API\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="d9_jSCQYjO2lgIQ7_E2L-1">
