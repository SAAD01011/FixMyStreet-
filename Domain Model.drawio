        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam roundcorner 8\nskinparam class {\n    BackgroundColor #FEF9E7\n    BorderColor #B7950B\n    ArrowColor #7D6608\n}\n\nentity \&quot;Citizen\&quot; as Citizen {\n    Full Legal Name\n    Mobile Phone Number\n    National ID / Citizen Profile\n}\n\nentity \&quot;Civic Hazard (Complaint)\&quot; as Complaint {\n    Tracking Identifier\n    Digital Photographic Evidence\n    GPS Geospatial Coordinates\n    Physical Street Location\n    Urgency Declaration\n    Assigned Priority Rating\n    Enforced SLA Time Window\n    Current Lifecycle Status\n}\n\nentity \&quot;Hazard Category\&quot; as Category {\n    Category Name (Road, Light, Sewage, Trash)\n    Default Severity Profile\n}\n\nentity \&quot;Municipal Department\&quot; as Department {\n    Department Title (Works, Sanitation, Power)\n    Jurisdiction Area\n}\n\nentity \&quot;Supervisory Officer\&quot; as Officer {\n    Employee Identifier\n    Desk Assignment\n}\n\nentity \&quot;Field Repair Technician\&quot; as Worker {\n    Technician Code\n    Trade Specialty (Asphalt, Electrician, Plumber)\n    Availability Flag\n}\n\nentity \&quot;Resolution Evidence (Proof)\&quot; as Proof {\n    Post-Repair Photo\n    Completion Timestamp\n    Technician Log Summary\n}\n\nentity \&quot;Service Evaluation (Feedback)\&quot; as Feedback {\n    Satisfaction Rating (1 to 5 Stars)\n    Citizen Critique Notes\n    Audit Disposition (Closed / Disputed)\n}\n\nentity \&quot;Service Level Agreement (SLA)\&quot; as SLA {\n    Priority Rank (P1 through P4)\n    Maximum Permitted Resolution Hours\n    Penalty Warning Threshold\n}\n\n&#39; Associations\nCitizen \&quot;1\&quot; --- \&quot;0..*\&quot; Complaint : spots &amp; reports\nComplaint \&quot;0..*\&quot; --- \&quot;1\&quot; Category : classified under\nComplaint \&quot;0..*\&quot; --- \&quot;1\&quot; Department : falls within jurisdiction of\nComplaint \&quot;1\&quo