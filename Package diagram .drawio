  <diagram name="Page-1" id="I_VgYvfEmJ1oLNemWyTz">
    <mxGraphModel dx="5144" dy="3320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam packageStyle folder\nskinparam ArrowColor #2C3E50\n\npackage \&quot;1. Presentation Layer (Client Tier)\&quot; as Presentation {\n    [Citizen Web/Mobile Portal] as CitizenUI\n    [Department Operations Console] as OfficerUI\n    [Field Worker PWA / Mobile Client] as WorkerUI\n    [Executive Admin Analytics Dashboard] as AdminUI\n}\n\npackage \&quot;2. Application &amp; API Gateway Layer\&quot; as Gateway {\n    [Authentication &amp; Authorization Controller] as AuthCtrl\n    [Complaint Intake &amp; Tracking Controller] as ComplaintCtrl\n    [Department Dispatch Controller] as DispatchCtrl\n    [Worker Task Controller] as WorkerCtrl\n    [Feedback &amp; Verification Controller] as FeedbackCtrl\n    [Management Reporting Controller] as ReportCtrl\n}\n\npackage \&quot;3. Core Domain &amp; Business Services Layer\&quot; as DomainServices {\n    [Routing &amp; Jurisdictional Engine] as RoutingEngine\n    [Urgency &amp; SLA Rules Processor] as SlaEngine\n    [Spatial Duplicate Detection Service] as DuplicateService\n    [Notification Dispatch Service] as NotifService\n    [Analytics &amp; Heatmap Aggregator] as AnalyticsEngine\n}\n\npackage \&quot;4. Data Access Layer (Persistence Tier)\&quot; as DAL {\n    interface \&quot;IUserRepository\&quot; as UserRepo\n    interface \&quot;IComplaintRepository\&quot; as ComplaintRepo\n    interface \&quot;IDepartmentRepository\&quot; as DeptRepo\n    interface \&quot;IFeedbackRepository\&quot; as FeedbackRepo\n    interface \&quot;ISlaAuditRepository\&quot; as SlaRepo\n}\n\npackage \&quot;5. Infrastructure &amp; External Services Tier\&quot; as Infra {\n    database \&quot;PostgreSQL Relational DB\\n(JSONB, PostGIS Spatial)\&quot; as RelationalDB\n    cloud \&quot;Amazon Web Services (AWS S3)\\n(Photo Evidence Storage)\&quot; as S3Storage\n    cloud \&quot;Google Maps Platform\\n(Geolocation &amp; Geocoding)\&quot; as GoogleMaps\n    cloud \&quot;Notification Gateway Provider\\n(Twilio SMS / SendGrid Email)\&quot; as CommGateway\n}\n\n&#39; Inter-package bindings\nPresentation ..&gt; Gateway : RESTful HTTPS / JSON Web Tokens\nGateway ..&gt; DomainServices : Invokes Business Rules\nDomainServices ..&gt; DAL : Inversion of Control / Repositories\nDAL ..&gt; RelationalDB : Object-Relational Mapping (Prisma/TypeORM)\n\nComplaintCtrl ..&gt; S3Storage : Uploads Evidence\nComplaintCtrl ..&gt; GoogleMaps : Lat/Long Reverse Geocode\nNotifService ..&gt; CommGateway : Dispatches SMS/Email Alerts\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mLDLevk8RU6CMfIB7Znc-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
